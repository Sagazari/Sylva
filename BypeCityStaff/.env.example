# Token do bot (Discord Developer Portal > Bot)
TOKEN=cole_o_token_aqui
# ID da aplicação (Developer Portal > General Information)
CLIENT_ID=cole_o_client_id_aqui
# ID do seu servidor (deixe vazio para registrar comandos globalmente)
GUILD_ID=
# Canal de logs da staff (opcional)
LOG_CHANNEL_ID=

# ---- IA (Gemini) ----
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo do Gemini. Se der erro 404, troque por um nome atual em https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
# Nome da personagem (também é o nome que as pessoas chamam no chat)
IA_NOME=sylva
# Apelidos que também chamam a atenção dela (separe por vírgula)
IA_APELIDOS=syl
# Fuso horário da rotina (manhã = babá, tarde = livre, noite = estuda)
IA_TZ=America/Sao_Paulo
